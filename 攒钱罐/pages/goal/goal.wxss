.empty-card { padding: 70rpx 32rpx; }

.plan { margin-top: 8rpx; }
.plan-grid { display: flex; flex-wrap: wrap; gap: 12rpx; max-height: 360rpx; overflow-y: auto; }
.plan-cell {
  width: 92rpx; height: 72rpx; border-radius: 12rpx;
  background: #f6f7f9; color: var(--text-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 600;
}
.plan-cell.done { background: #eafaf1; color: var(--theme-dark); text-decoration: line-through; }

.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); display: flex; align-items: center;
  justify-content: center; z-index: 100; padding: 48rpx;
}
.dialog { background: #fff; border-radius: 28rpx; padding: 40rpx 36rpx; width: 100%; }
.fld {
  background: #f6f7f9; border-radius: 14rpx; padding: 24rpx; margin-bottom: 8rpx; font-size: 28rpx;
}
.methods { display: flex; flex-direction: column; gap: 14rpx; }
.method { padding: 18rpx 22rpx; border-radius: 14rpx; background: #f6f7f9; }
.method.on { background: #eafaf1; border: 2rpx solid var(--theme); }
.fld-row {
  display: flex; justify-content: space-between; align-items: center;
  background: #f6f7f9; border-radius: 14rpx; padding: 24rpx; margin-top: 16rpx; font-size: 28rpx;
}
.fld-sm { text-align: right; font-weight: 600; }

.wish { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.wish:last-child { border-bottom: none; }
.wish-icon { font-size: 52rpx; }
.wish.locked { opacity: 0.6; }
