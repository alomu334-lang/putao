<view class="page">
  <!-- 概览 -->
  <view class="cards3">
    <view class="mini card">
      <text class="muted">本月支出</text>
      <text class="money mini-money">{{monthTotal}}</text>
    </view>
    <view class="mini card">
      <text class="muted">存钱罐</text>
      <text class="money mini-money theme">{{savings}}</text>
    </view>
    <view class="mini card">
      <text class="muted">累计罚金</text>
      <text class="money mini-money danger">{{penaltyPool}}</text>
    </view>
  </view>

  <!-- 分类占比 -->
  <view class="card">
    <view class="bold" style="margin-bottom:20rpx">本月分类占比</view>
    <view wx:if="{{catList.length===0}}" class="muted center" style="padding:30rpx 0">本月暂无支出</view>
    <view wx:for="{{catList}}" wx:key="key" class="cat-row">
      <view class="row" style="margin-bottom:8rpx">
        <text style="margin-right:10rpx">{{item.icon}}</text>
        <text class="text-2" style="flex:1">{{item.name}}</text>
        <text class="bold">{{item.amountText}} · {{item.percent}}%</text>
      </view>
      <view class="bar"><view style="width:{{item.percent}}%"></view></view>
    </view>
  </view>

  <!-- 近7天趋势 -->
  <view class="card">
    <view class="bold" style="margin-bottom:24rpx">近 7 天支出趋势</view>
    <view class="trend">
      <view wx:for="{{trend}}" wx:key="date" class="trend-col">
        <text class="trend-val">{{item.amount > 0 ? item.amount : ''}}</text>
        <view class="trend-bar-wrap">
          <view class="trend-bar" style="height:{{item.h}}%"></view>
        </view>
        <text class="muted trend-date">{{item.date}}</text>
      </view>
    </view>
  </view>

  <view class="card center">
    <text class="muted">累计总支出</text>
    <text class="money danger" style="font-size:44rpx">{{totalExpense}}</text>
  </view>
</view>
