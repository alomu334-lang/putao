.tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.tab {
  flex: 1; text-align: center; padding: 20rpx 0; background: #fff;
  border-radius: 16rpx; color: var(--text-2); font-weight: 600;
}
.tab.on { background: var(--theme); color: #fff; }

.rec { padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.rec:last-child { border-bottom: none; }
.rec-icon { font-size: 44rpx; margin-right: 20rpx; }
.empty { text-align: center; }
