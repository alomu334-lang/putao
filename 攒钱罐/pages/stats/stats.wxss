.cards3 { display: flex; gap: 18rpx; }
.mini { flex: 1; display: flex; flex-direction: column; gap: 10rpx; padding: 24rpx; }
.mini-money { font-size: 30rpx; }

.cat-row { margin-bottom: 22rpx; }
.cat-row:last-child { margin-bottom: 0; }

.trend { display: flex; align-items: flex-end; justify-content: space-between; height: 320rpx; }
.trend-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.trend-val { font-size: 20rpx; color: var(--text-3); height: 28rpx; }
.trend-bar-wrap { width: 36rpx; height: 200rpx; display: flex; align-items: flex-end; }
.trend-bar { width: 100%; background: var(--theme); border-radius: 8rpx 8rpx 0 0; min-height: 4rpx; }
.trend-date { font-size: 22rpx; }
