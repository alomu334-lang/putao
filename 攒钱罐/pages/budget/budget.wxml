<wxs src="../../utils/money.wxs" module="m" />
<view class="page">
  <view class="card center">
    <view class="muted">设置今天的可用金额</view>
    <view class="amount-input">
      <text class="rmb">¥</text>
      <input class="num" type="digit" focus placeholder="0.00" value="{{amount}}" bindinput="onInput" />
      <text class="clear" bindtap="clear" wx:if="{{amount}}">✕</text>
    </view>
    <view class="muted" style="font-size:24rpx">
      当前今日总额度：{{m.fmt(current)}}
      <text wx:if="{{carryBase > 0}}">（含昨日结转 {{m.fmt(carryBase)}}）</text>
    </view>
  </view>

  <view class="card">
    <view class="muted" style="margin-bottom:20rpx">快速添加</view>
    <view class="presets">
      <view wx:for="{{presets}}" wx:key="*this" class="preset" data-v="{{item}}" bindtap="tapPreset">+{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="row between" style="padding:10rpx 0">
      <view>
        <view class="bold">昨日结余结转</view>
        <view class="muted" style="font-size:24rpx">未花完的钱自动计入明天额度</view>
      </view>
      <switch checked="{{carryOverEnabled}}" color="#07c160" bindchange="toggleCarry" />
    </view>
    <view class="row between" style="padding:10rpx 0">
      <view>
        <view class="bold">结余自动存钱</view>
        <view class="muted" style="font-size:24rpx">每天没花完的余额自动进存钱罐</view>
      </view>
      <switch checked="{{savingsAuto}}" color="#07c160" bindchange="toggleSave" />
    </view>
  </view>

  <button class="btn btn-primary btn-block" bindtap="confirm">保存今日可用金额</button>
</view>
