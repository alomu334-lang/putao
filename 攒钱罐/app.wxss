/* 全局样式 */
page {
  --theme: #07c160;
  --theme-dark: #06a650;
  --bg: #f4f5f7;
  --card: #ffffff;
  --text: #1f2329;
  --text-2: #646a73;
  --text-3: #9aa0a6;
  --danger: #fa5151;
  --warning: #ff976a;
  --line: #ebedf0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}
.btn::after { border: none; }
.btn-primary {
  background: var(--theme);
  color: #fff;
}
.btn-primary:active { background: var(--theme-dark); }
.btn-ghost {
  background: #eafaf1;
  color: var(--theme-dark);
}
.btn-danger {
  background: var(--danger);
  color: #fff;
}
.btn-block { width: 100%; }
.btn[disabled] {
  background: #e9ebf0 !important;
  color: #b7bcc4 !important;
}

.row {
  display: flex;
  align-items: center;
}
.between { justify-content: space-between; }
.muted { color: var(--text-3); }
.text-2 { color: var(--text-2); }
.danger { color: var(--danger); }
.theme { color: var(--theme); }
.bold { font-weight: 600; }
.center { text-align: center; }

.money { font-weight: 700; letter-spacing: 0.5rpx; }

.bar {
  height: 16rpx;
  border-radius: 8rpx;
  background: #eef0f3;
  overflow: hidden;
}
.bar > view {
  height: 100%;
  border-radius: 8rpx;
  background: var(--theme);
  transition: width 0.4s ease;
}
.bar.warn > view { background: var(--warning); }
.bar.danger > view { background: var(--danger); }
